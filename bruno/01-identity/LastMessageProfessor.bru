meta {
  name: LastMessageProfessor
  type: http
  seq: 7
}

get {
  url: {{mailpitUrl}}/api/v1/messages?limit=20
  auth: none
}

tests {
  expect(res.status).to.equal(200);
  const found = res.body.messages.find(m =>
    (m.To || []).some(t => (t.Address || "").includes(bru.getEnvVar("professorEmail")))
  );
  expect(found, "email de verificación no encontrado en Mailpit").to.exist;
  bru.setVar("msgId", found.ID);
}
