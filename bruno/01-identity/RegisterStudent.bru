meta {
  name: RegisterStudent
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "username": "{{studentUser}}",
    "email": "{{studentEmail}}",
    "password": "{{studentPass}}"
  }
}

tests {
  expect(res.status).to.be.oneOf([200, 201, 409]); // 409 = re-run idempotente (usuario persiste);
}
