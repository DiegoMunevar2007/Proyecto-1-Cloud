meta {
  name: RegisterProfessor
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "username": "{{professorUser}}",
    "email": "{{professorEmail}}",
    "password": "{{professorPass}}",
    "role": "professor"
  }
}

tests {
  expect(res.status).to.be.oneOf([200, 201]);
}
