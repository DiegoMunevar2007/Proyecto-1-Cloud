meta {
  name: LoginAdmin
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{adminUser}}",
    "password": "{{adminPass}}"
  }
}

tests {
  expect(res.status).to.equal(200);
  expect(res.body.token).to.be.a("string").and.not.empty;
  bru.setVar("adminToken", res.body.token);
}
