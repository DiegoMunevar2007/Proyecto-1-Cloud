meta {
  name: RegisterAdmin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "username": "{{adminUser}}",
    "email": "{{adminEmail}}",
    "password": "{{adminPass}}",
    "role": "admin"
  }
}

tests {
  expect(res.status).to.be.oneOf([200, 201]);
}
