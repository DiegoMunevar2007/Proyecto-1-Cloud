meta {
  name: LoginProfessor
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{professorUser}}",
    "password": "{{professorPass}}"
  }
}

tests {
  expect(res.status).to.equal(200);
  expect(res.body.token).to.be.a("string").and.not.empty;
  bru.setVar("professorToken", res.body.token);
}