  token: {{professorToken}}
}

body:json {
  {
    "type": "text",
    "title": "Recurso temporal",
    "markdown_body": "# Temporal"
  }
}

tests {
  expect(res.status).to.equal(201);
  bru.setVar("tmpResourceId", res.body.resource.id);
}
