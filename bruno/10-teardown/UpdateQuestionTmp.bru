meta {
  name: UpdateQuestionTmp
  type: http
  seq: 13
}

put {
  url: {{baseUrl}}/api/v1/quizzes/{{tmpQuizId}}/questions/{{tmpQuestionId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{professorToken}}
}

body:json {
  {
    "prompt": "¿Temporal editada?",
    "choices": ["Sí", "No", "Tal vez"],
    "correct_index": 2
  }
}

tests {
  expect(res.status).to.equal(200);
  expect(res.body.question.prompt).to.equal("¿Temporal editada?");
}
