meta {
  name: AddModuleB
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/courses/{{courseBId}}/modules
  body: json
  auth: bearer
}

auth:bearer {
  token: {{professorToken}}
}

body:json {
  {
    "title": "Módulo único"
  }
}

tests {
  expect(res.status).to.equal(201);
  bru.setVar("moduleBId", res.body.module.id);
}
