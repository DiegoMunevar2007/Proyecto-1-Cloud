meta {
  name: AddResourceFile
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/units/{{unitBId}}/resources
  body: json
  auth: bearer
}

auth:bearer {
  token: {{professorToken}}
}

body:json {
  {
    "type": "file",
    "title": "Archivo de prueba"
  }
}

tests {
  expect(res.status).to.equal(201);
  bru.setVar("fileResourceId", res.body.resource.id);
}
