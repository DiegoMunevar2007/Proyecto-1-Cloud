meta {
  name: UpdateRole
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/v1/admin/users/{{userId}}/role
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "role": "student"
  }
}

tests {
  expect(res.status).to.equal(200);
  expect(res.body.user.role).to.equal("student");
}
