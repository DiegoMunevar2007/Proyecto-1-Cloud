meta {
  name: ListUsers
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/admin/users
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  expect(res.status).to.equal(200);
  expect(res.body.total).to.be.above(0);
  const stu = res.body.users.find(u => u.username === "estudiante2");
  expect(stu, "estudiante no listado").to.exist;
  bru.setVar("userId", stu.id);
}
