meta {
  name: DownloadUrl
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/resources/{{fileResourceId}}/download-url
  auth: bearer
}

auth:bearer {
  token: {{studentToken}}
}

tests {
  expect(res.status).to.equal(200);
  expect(res.body.url).to.be.a("string").and.not.empty;
  expect(res.body.hls).to.equal(false);
}
