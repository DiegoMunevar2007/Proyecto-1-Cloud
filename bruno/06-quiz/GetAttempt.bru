meta {
  name: GetAttempt
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/attempts/{{attemptId}}
  auth: bearer
}

auth:bearer {
  token: {{studentToken}}
}

tests {
  expect(res.status).to.equal(200);
  expect(res.body.score).to.equal(100);
  expect(JSON.stringify(res.body)).to.not.contain("correct_index");
}
