# Plantilla de configuración cloud (sin valores secretos).
# Los scripts de arranque generan /opt/mooc/.env en cada VM resolviendo los
# secretos con la cuenta de servicio; este archivo documenta las claves usadas.

POSTGRES_HOST=<IP_PRIVADA_CLOUD_SQL>
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<SECRET_MANAGER>
POSTGRES_DB=mydb
POSTGRES_SSLMODE=disable
REDIS_ADDR=10.10.1.20:6379
REDIS_PASSWORD=<SECRET_MANAGER>
JWT_SECRET=<SECRET_MANAGER>
S3_ENDPOINT=storage.googleapis.com
S3_PUBLIC_ENDPOINT=https://storage.googleapis.com
S3_ACCESS_KEY=<SECRET_MANAGER>
S3_SECRET_KEY=<SECRET_MANAGER>
S3_USE_SSL=true
S3_REGION=auto
S3_BUCKET_ORIGINALS=<BUCKET_ORIGINALS>
S3_BUCKET_HLS=<BUCKET_HLS>
S3_BUCKET_PUBLIC=<BUCKET_PUBLIC>
CDN_BASE_URL=
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=prueba@test.com
CLAMAV_HOST=clamav:3310
WORKER_CONCURRENCY=10
MOOC_DOMAIN=<DOMINIO_O_IP>
NEXT_PUBLIC_API_URL=https://<DOMINIO_O_IP>
