meta {
  name: UpdateStatusBlocked
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/v1/admin/users/{{userId}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "status": "blocked"
  }
}

tests {
  expect(res.status).to.equal(200);
  expect(res.body.user.status).to.equal("blocked");
}
