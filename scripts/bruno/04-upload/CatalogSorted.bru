meta {
  name: CatalogSorted
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/v1/courses?sort=title%20asc
  auth: none
}

tests {
  expect(res.status).to.equal(200);
  expect(res.body.total).to.be.at.least(2);
  expect(res.body.courses[0].title).to.equal("Curso Bruno E2E");
  expect(res.body.courses[1].title).to.equal("Curso Bruno Upload");
}
