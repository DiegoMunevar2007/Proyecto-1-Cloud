meta {
  name: PatchWrongOffset
  type: http
  seq: 17
}

patch {
  url: {{uploadLocationMismatch}}
  body: file
  auth: bearer
}

auth:bearer {
  token: {{professorToken}}
}

headers {
  Tus-Resumable: 1.0.0
  Upload-Offset: 5
}

body:file {
  file: @file(fixtures/sample.txt) @contentType(application/offset+octet-stream)
}

tests {
  expect(res.status).to.equal(409);
}
