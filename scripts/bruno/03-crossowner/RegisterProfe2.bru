meta {
  name: RegisterProfe2
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "username": "profe2",
    "email": "profe2@local.test",
    "password": "{{professorPass}}",
    "role": "professor"
  }
}

tests {
  expect(res.status).to.be.oneOf([200, 201, 409]); // 409 = re-run idempotente (usuario persiste);
}
