meta {
  name: Validate
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/v1/courses/{{courseId}}/validate
  auth: bearer
}

auth:bearer {
  token: {{professorToken}}
}

tests {
  expect(res.status).to.equal(200);
  expect(res.body.valid).to.equal(true);
  expect(res.body.errors).to.be.empty;
}
