meta {
  name: AddResourcePdf
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/units/{{unitId}}/resources
  body: json
  auth: bearer
}

auth:bearer {
  token: {{professorToken}}
}

body:json {
  {
    "type": "pdf",
    "title": "Apuntes PDF",
    "external_url": "https://ejemplo.com/apuntes.pdf"
  }
}

tests {
  expect(res.status).to.equal(201);
  bru.setVar("pdfStableId", res.body.resource.stable_id);
}
