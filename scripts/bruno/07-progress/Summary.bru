meta {
  name: Summary
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/progress/{{courseId}}
  auth: bearer
}

auth:bearer {
  token: {{studentToken}}
}

tests {
  expect(res.status).to.equal(200);
  expect(res.body.total).to.equal(3);
  expect(res.body.done).to.equal(3);
  expect(res.body.percent).to.equal(100);
  expect(res.body.status).to.equal("approved");
  expect(res.body.badge).to.be.a("string").and.not.empty;
  bru.setVar("badgeCode", res.body.badge);
  const textStable = bru.getVar("textStableId");
  expect(res.body.positions[textStable].completed).to.equal(true);
  const pdfStable = bru.getVar("pdfStableId");
  expect(res.body.positions[pdfStable].page).to.equal(3);
}
