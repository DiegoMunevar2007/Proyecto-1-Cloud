meta {
  name: HeartbeatVideo
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/progress/heartbeat
  body: json
  auth: bearer
}

auth:bearer {
  token: {{studentToken}}
}

body:json {
  {
    "stable_id": "{{videoStableId}}",
    "position_sec": 540,
    "duration_sec": 600,
    "event": "playing"
  }
}

tests {
  expect(res.status).to.equal(200);
}
