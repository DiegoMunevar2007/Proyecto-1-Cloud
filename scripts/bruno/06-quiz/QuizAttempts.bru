meta {
  name: QuizAttempts
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/quizzes/{{quizId}}/attempts
  auth: bearer
}

auth:bearer {
  token: {{professorToken}}
}

tests {
  expect(res.status).to.equal(200);
  expect(res.body.total).to.be.at.least(1);
  expect(res.body.attempts[0].score).to.equal(100);
}
