meta {
  name: SubmitAgain
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/attempts/{{attemptId}}/submit
  auth: bearer
}

auth:bearer {
  token: {{studentToken}}
}

tests {
  expect(res.status).to.equal(200);
  expect(res.body.status).to.equal("submitted");
  expect(res.body.score).to.equal(100);
  expect(res.body.feedback).to.eql([true, true]);
}
